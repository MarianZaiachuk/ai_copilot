# === LLM Provider Configuration ===
# Supported values: openai | groq | ollama | lmstudio | gemini
LLM_PROVIDER=openai

# OpenAI-compatible credentials (used for openai, groq, ollama, lmstudio)
OPENAI_API_KEY=
# Optional custom endpoint. Left blank, auto-defaults apply for groq, ollama, and lmstudio.
OPENAI_BASE_URL=
# Active models can also be fetched dynamically inside Settings -> LLM Provider
OPENAI_MODEL=gpt-6-luna

# Google Gemini credentials (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Generation parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# === Whisper STT Configuration ===
# Recommended models for Ukrainian: large-v3-turbo | medium
WHISPER_MODEL=large-v3-turbo
# Supported values: cuda | cpu | auto
WHISPER_DEVICE=cuda
# Recommended on RTX GPUs: float16 (automatically switches to int8 on CPU fallback)
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=uk
WHISPER_BEAM_SIZE=5

# === Audio Capture (WASAPI Loopback) ===
AUDIO_CHUNK_SECONDS=5.0
AUDIO_OVERLAP_SECONDS=0.85
AUDIO_SILENCE_SECONDS=0.8
AUDIO_SILENCE_THRESHOLD=0.006

# === Context, Overlay & Hotkeys ===
# Window (in seconds) of recent transcript sent to LLM when no text is selected
TRANSCRIPT_WINDOW_SECONDS=60
CONTEXT_MAX_CHARS=120000
# If total loaded docs exceed this threshold, hybrid BM25 + 4-gram RAG selects top sections
RAG_CONTEXT_BUDGET_CHARS=12000
# Optional comma-separated domain terms for Whisper post-recognition spelling normalization
CUSTOM_VOCABULARY=
HOTKEY_ANSWER=ctrl+space
HOTKEY_TOGGLE=ctrl+shift+h
OVERLAY_OPACITY=92
OVERLAY_STEALTH=true
DASHBOARD_STEALTH=false
OVERLAY_FONT_SCALE=1.0

# === Web Search, Screen Vision & AI Agent ===
WEB_SEARCH_ENABLED=false
# Supported values: auto | ddgs | tavily | brave | wikipedia
WEB_SEARCH_PROVIDER=auto
# Optional key for Tavily (tvly-...) or Brave Search (BSA...); leave blank for free DDGS/Wikipedia
WEB_SEARCH_API_KEY=
# Supported values: agent | fast
WEB_AGENT_MODE=agent
WEB_SEARCH_MAX_RESULTS=5
# Optional path to obscura.exe for JS-heavy webpage rendering
OBSCURA_PATH=
# Allow the agent to capture a screenshot of your screen (code/slides) on answer trigger
SCREEN_VISION_ENABLED=false
# -1 = auto primary monitor, 0/1/... = specific display index
SCREEN_CAPTURE_INDEX=-1
SCREEN_CAPTURE_MAX_WIDTH=1600

# Optional override for the default Ukrainian defense assistant system prompt:
# SYSTEM_PROMPT=
